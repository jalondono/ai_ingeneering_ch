# Copiá este archivo como .env y completá las API keys.

# Proveedor que carga el AsyncLLMManager: openai o anthropic (también gemini).
# main.py prueba cada proveedor de la lista; separalos por coma para probar varios.
LLM_PROVIDER=openai,anthropic

# Proveedor de respaldo opcional si el principal falla (openai, anthropic o gemini).
# Vacío = sin fallback.
LLM_FALLBACK_PROVIDER=

# API keys (solo hacen falta las de los proveedores que uses)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Parámetros del modelo, validados con Pydantic
# LLM_TEMPERATURE: de 0 a 2. LLM_MAX_TOKENS: entero mayor a 0.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=300

# Opcionales: modelo de cada proveedor (estos son los valores por defecto)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GEMINI_MODEL=gemini-3.5-flash-lite
